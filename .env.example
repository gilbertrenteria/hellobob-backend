# Copy this file to .env and fill in real values when you're ready to go
# live. Until ANTHROPIC_API_KEY and TWILIO_ACCOUNT_SID are both set, the
# server runs in DRY RUN mode automatically: it logs what it would have
# sent instead of actually calling Claude or Twilio, so you can run and
# test everything before paying for either.

PORT=3000

# Get this from https://platform.claude.com (Console > API keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Get these from https://console.twilio.com (Account SID + Auth Token on
# the dashboard homepage; buy a number under Phone Numbers > Buy a number
# — make sure SMS *and* Voice are both enabled on it, not just SMS, per the
# FL/OK callback-number note in src/compliance/stateRules.js).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# The public URL this server will be reachable at once deployed (Railway,
# Render, Fly.io, etc. all give you one). Twilio needs this to reach your
# webhooks, and it's also used to validate that inbound webhook requests
# really came from Twilio. Leave as localhost for local dev with a tunnel
# tool like ngrok — set it to whatever URL ngrok gives you.
PUBLIC_BASE_URL=http://localhost:3000

# ---- Marketing-site "Ask Bob" chat + sign-up (src/webchat, src/signup.js) ----

# Get this from https://resend.com (free tier is plenty to start). Powers the
# two automatic emails sent the moment someone signs up: a welcome email to
# them with a link to the setup questionnaire, and a notification to you.
# Leave unset and both just get logged instead of sent (like DRY_RUN).
RESEND_API_KEY=
# Must be on a domain you've verified in Resend once you have one (e.g.
# "HelloBob <hello@hellobob.com>"); until then Resend's own test address works.
EMAIL_FROM=HelloBob <onboarding@resend.dev>
# Where new-signup notifications go.
NOTIFY_EMAIL=gilbertrenteria@yahoo.com

# The detailed 15-section setup questionnaire ("Let's Build Your Bob") is
# still a real Jotform — only the quick sign-up moved to this backend's own
# database. Change this if that Jotform's URL ever changes.
# JOTFORM_QUESTIONNAIRE_URL=https://form.jotform.com/262458290659065

# Which site(s) may call /api/website-chat and /api/signup from a browser.
# '*' is fine for now; once HelloBob has its own domain, lock this down to
# it (e.g. https://www.hellobob.com) so no one else can call these and run
# up your Claude/Resend usage.
# WEBSITE_CHAT_ALLOWED_ORIGIN=*

# A long random string of your choosing — lets you view captured signups at
# yourapp.onrender.com/api/signups?key=<this value>. Leave unset to disable
# that route entirely.
ADMIN_KEY=

# Optional overrides — safe to leave unset.
# DB_PATH=./data/hellobob.db
# QUIET_HOURS_START=8
# QUIET_HOURS_END=21
# DRY_RUN=true
# WEBSITE_CHAT_MAX_PER_IP_PER_HOUR=30
# WEBSITE_CHAT_DAILY_CAP=300
